{% extends 'admin/base.html.twig' %}

{% block title %}Profesores{% endblock %}
{% block topbar_title %}Profesores{% endblock %}

{% block body %}
    <div class="page-header">
        <div>
            <h1>Plantel docente</h1>
            <p class="meta">Tocá un profesor para ver su ficha, editarlo o gestionar cursos.</p>
        </div>
        <div class="page-header__actions">
            <a class="btn btn-accent" href="{{ path('admin_profesor_new') }}"><i class="bi bi-person-plus" aria-hidden="true"></i> Nuevo profesor</a>
        </div>
    </div>

    <div class="toolbar">
        <div class="field">
            <label for="filtro-profesores">Buscar</label>
            <input id="filtro-profesores" type="search" placeholder="DNI, nombre o curso…" autocomplete="off">
        </div>
        <div class="field">
            <label for="filtro-estado">Estado</label>
            <select id="filtro-estado">
                <option value="">Todos</option>
                <option value="activo">Activos</option>
                <option value="baja">De baja</option>
            </select>
        </div>
    </div>

    {% if profesores|length == 0 %}
        <div class="card empty-state">
            <div class="empty-state__icon" aria-hidden="true">👤</div>
            <strong>Todavía no hay profesores</strong>
            <span>Cargá el primero para empezar a registrar asistencia.</span>
            <p style="margin-top:1rem;"><a class="btn" href="{{ path('admin_profesor_new') }}"><i class="bi bi-person-plus" aria-hidden="true"></i> Crear profesor</a></p>
        </div>
    {% else %}
        <div class="table-wrap table-desktop">
            <table class="data-table data-table--clickable">
                <thead>
                    <tr>
                        <th></th>
                        <th>DNI</th>
                        <th>Apellido y nombre</th>
                        <th>Cursos</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for profesor in profesores %}
                        {% set cursosBusqueda = '' %}
                        {% set cursosEtiquetas = [] %}
                        {% for asignacion in profesor.asignaciones %}
                            {% set cursosBusqueda = cursosBusqueda ~ ' ' ~ asignacion.etiqueta %}
                            {% set cursosEtiquetas = cursosEtiquetas|merge([asignacion.etiqueta]) %}
                        {% endfor %}
                        <tr class="teacher-row"
                            tabindex="0"
                            role="button"
                            aria-haspopup="dialog"
                            data-search="{{ (profesor.dni ~ ' ' ~ profesor.nombreCompleto ~ cursosBusqueda)|lower }}"
                            data-estado="{{ profesor.isActive ? 'activo' : 'baja' }}"
                            data-profesor-id="{{ profesor.id }}"
                            data-profesor-nombre="{{ profesor.nombreCompleto }}"
                            data-profesor-dni="{{ profesor.dni }}"
                            data-profesor-activo="{{ profesor.isActive ? '1' : '0' }}"
                            data-profesor-foto="{{ profesor.foto ? asset(profesor.foto) : '' }}"
                            data-profesor-iniciales="{{ profesor.iniciales }}"
                            data-profesor-cursos="{{ cursosEtiquetas|join(' · ') }}"
                            data-show-url="{{ path('admin_profesor_show', {id: profesor.id}) }}"
                            data-edit-url="{{ path('admin_profesor_edit', {id: profesor.id}) }}"
                            data-cursos-url="{{ path('admin_horario_edit', {id: profesor.id}) }}"
                            data-estado-url="{{ path('admin_profesor_estado', {id: profesor.id}) }}"
                            data-estado-token="{{ csrf_token('profesor_estado_' ~ profesor.id) }}">
                            <td>{% include 'partials/avatar.html.twig' with { persona: profesor, size: 'list' } only %}</td>
                            <td><code>{{ profesor.dni }}</code></td>
                            <td><strong>{{ profesor.nombreCompleto }}</strong></td>
                            <td>
                                {% for asignacion in profesor.asignaciones %}
                                    <span class="badge badge-course">{{ asignacion.etiqueta }}</span>
                                {% else %}
                                    <span class="meta">Sin cursos</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if profesor.isActive %}
                                    <span class="badge badge-on">Activo</span>
                                {% else %}
                                    <span class="badge badge-off">De baja</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="teacher-cards" id="teacher-cards">
            {% for profesor in profesores %}
                {% set cursosBusqueda = '' %}
                {% set cursosEtiquetas = [] %}
                {% for asignacion in profesor.asignaciones %}
                    {% set cursosBusqueda = cursosBusqueda ~ ' ' ~ asignacion.etiqueta %}
                    {% set cursosEtiquetas = cursosEtiquetas|merge([asignacion.etiqueta]) %}
                {% endfor %}
                <article class="teacher-card teacher-row"
                         tabindex="0"
                         role="button"
                         aria-haspopup="dialog"
                         data-search="{{ (profesor.dni ~ ' ' ~ profesor.nombreCompleto ~ cursosBusqueda)|lower }}"
                         data-estado="{{ profesor.isActive ? 'activo' : 'baja' }}"
                         data-profesor-id="{{ profesor.id }}"
                         data-profesor-nombre="{{ profesor.nombreCompleto }}"
                         data-profesor-dni="{{ profesor.dni }}"
                         data-profesor-activo="{{ profesor.isActive ? '1' : '0' }}"
                         data-profesor-foto="{{ profesor.foto ? asset(profesor.foto) : '' }}"
                         data-profesor-iniciales="{{ profesor.iniciales }}"
                         data-profesor-cursos="{{ cursosEtiquetas|join(' · ') }}"
                         data-show-url="{{ path('admin_profesor_show', {id: profesor.id}) }}"
                         data-edit-url="{{ path('admin_profesor_edit', {id: profesor.id}) }}"
                         data-cursos-url="{{ path('admin_horario_edit', {id: profesor.id}) }}"
                         data-estado-url="{{ path('admin_profesor_estado', {id: profesor.id}) }}"
                         data-estado-token="{{ csrf_token('profesor_estado_' ~ profesor.id) }}">
                    <div class="teacher-card__top">
                        <div class="teacher-card__identity">
                            {% include 'partials/avatar.html.twig' with { persona: profesor, size: 'list' } only %}
                            <div>
                                <div class="teacher-card__name">{{ profesor.nombreCompleto }}</div>
                                <div class="meta">DNI {{ profesor.dni }}</div>
                            </div>
                        </div>
                        {% if profesor.isActive %}
                            <span class="badge badge-on">Activo</span>
                        {% else %}
                            <span class="badge badge-off">De baja</span>
                        {% endif %}
                    </div>
                    <div>
                        {% for asignacion in profesor.asignaciones %}
                            <span class="badge badge-course">{{ asignacion.etiqueta }}</span>
                        {% else %}
                            <span class="meta">Sin cursos</span>
                        {% endfor %}
                    </div>
                </article>
            {% endfor %}
        </div>

        <div class="modal" id="modal-profesor-acciones" hidden aria-hidden="true">
            <div class="modal__backdrop" data-close-modal tabindex="-1"></div>
            <div class="modal__dialog modal__dialog--actions" role="dialog" aria-modal="true" aria-labelledby="modal-profesor-title">
                <header class="modal__header">
                    <div class="teacher-modal__identity">
                        <span class="avatar avatar--list avatar--fallback" id="modal-profesor-avatar" aria-hidden="true">—</span>
                        <div>
                            <h2 id="modal-profesor-title">Profesor</h2>
                            <p class="meta" id="modal-profesor-meta"></p>
                        </div>
                    </div>
                    <button type="button" class="modal__close" data-close-modal aria-label="Cerrar">×</button>
                </header>
                <div class="modal__body">
                    <p class="meta" id="modal-profesor-cursos" style="margin-top:0;"></p>
                    <div class="teacher-actions">
                        <a class="btn teacher-actions__btn teacher-actions__btn--accent" id="modal-btn-ver" href="#"><i class="bi bi-person-vcard" aria-hidden="true"></i> Ver ficha</a>
                        <a class="btn teacher-actions__btn" id="modal-btn-editar" href="#"><i class="bi bi-pencil-square" aria-hidden="true"></i> Editar</a>
                        <a class="btn teacher-actions__btn" id="modal-btn-cursos" href="#"><i class="bi bi-calendar-week" aria-hidden="true"></i> Cursos</a>
                        <form method="post" id="modal-form-estado" class="teacher-actions__full">
                            <input type="hidden" name="_token" id="modal-estado-token" value="">
                            <button class="btn teacher-actions__btn teacher-actions__btn--danger" id="modal-btn-estado" type="submit"><i class="bi bi-person-x" aria-hidden="true"></i> Dar de baja</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <script>
        (function () {
            var q = document.getElementById('filtro-profesores');
            var estado = document.getElementById('filtro-estado');
            function applyFilters() {
                if (!q || !estado) return;
                var text = q.value.trim().toLowerCase();
                var st = estado.value;
                document.querySelectorAll('[data-search][data-estado]').forEach(function (el) {
                    var okText = text === '' || el.getAttribute('data-search').indexOf(text) !== -1;
                    var okEstado = st === '' || el.getAttribute('data-estado') === st;
                    el.hidden = !(okText && okEstado);
                });
            }
            if (q) q.addEventListener('input', applyFilters);
            if (estado) estado.addEventListener('change', applyFilters);

            var modal = document.getElementById('modal-profesor-acciones');
            if (!modal) return;
            var lastFocus = null;
            var title = document.getElementById('modal-profesor-title');
            var meta = document.getElementById('modal-profesor-meta');
            var cursos = document.getElementById('modal-profesor-cursos');
            var avatar = document.getElementById('modal-profesor-avatar');
            var btnVer = document.getElementById('modal-btn-ver');
            var btnEditar = document.getElementById('modal-btn-editar');
            var btnCursos = document.getElementById('modal-btn-cursos');
            var formEstado = document.getElementById('modal-form-estado');
            var tokenInput = document.getElementById('modal-estado-token');
            var btnEstado = document.getElementById('modal-btn-estado');

            function openModal(el) {
                lastFocus = document.activeElement;
                var activo = el.getAttribute('data-profesor-activo') === '1';
                var foto = el.getAttribute('data-profesor-foto') || '';
                var iniciales = el.getAttribute('data-profesor-iniciales') || '';
                var cursosTxt = el.getAttribute('data-profesor-cursos') || '';

                title.textContent = el.getAttribute('data-profesor-nombre') || 'Profesor';
                meta.textContent = 'DNI ' + (el.getAttribute('data-profesor-dni') || '');
                cursos.textContent = cursosTxt ? ('Cursos: ' + cursosTxt) : 'Sin cursos asignados';

                if (foto) {
                    avatar.outerHTML = '<img class="avatar avatar--list" id="modal-profesor-avatar" src="' + foto + '" alt="">';
                    avatar = document.getElementById('modal-profesor-avatar');
                } else {
                    avatar.outerHTML = '<span class="avatar avatar--list avatar--fallback" id="modal-profesor-avatar" aria-hidden="true">' + iniciales + '</span>';
                    avatar = document.getElementById('modal-profesor-avatar');
                }

                btnVer.href = el.getAttribute('data-show-url');
                btnEditar.href = el.getAttribute('data-edit-url');
                btnCursos.href = el.getAttribute('data-cursos-url');
                formEstado.action = el.getAttribute('data-estado-url');
                tokenInput.value = el.getAttribute('data-estado-token');
                btnEstado.innerHTML = activo
                    ? '<i class="bi bi-person-x" aria-hidden="true"></i> Dar de baja'
                    : '<i class="bi bi-person-check" aria-hidden="true"></i> Reactivar';
                btnEstado.className = 'btn teacher-actions__btn ' + (activo ? 'teacher-actions__btn--danger' : 'teacher-actions__btn--ok');

                modal.hidden = false;
                modal.setAttribute('aria-hidden', 'false');
                document.body.classList.add('modal-open');
                window.setTimeout(function () { btnVer.focus(); }, 10);
            }

            function closeModal() {
                modal.hidden = true;
                modal.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('modal-open');
                if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();
            }

            document.querySelectorAll('.teacher-row').forEach(function (el) {
                el.addEventListener('click', function () { openModal(el); });
                el.addEventListener('keydown', function (event) {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        openModal(el);
                    }
                });
            });

            modal.querySelectorAll('[data-close-modal]').forEach(function (el) {
                el.addEventListener('click', closeModal);
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && !modal.hidden) closeModal();
            });
        })();
    </script>
{% endblock %}

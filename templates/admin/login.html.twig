<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Acceso administración · E.P.E.T N1</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="icon" href="{{ asset('uploads/logo/logo-epet-n1.png') }}" type="image/png">
</head>
<body>
    <main class="auth-shell">
        <section class="auth-card">
            <div class="auth-card__brand">
                {% include 'partials/college_logo.html.twig' with { logo_variant: 'hero', logo_href: path('home') } only %}
            </div>
            <h1>Administración</h1>
            <p class="meta">Ingresá con tu usuario institucional.</p>
            {% if error %}
                <div class="alert alert-error" role="alert">
                    {% if error.messageKey == 'Invalid credentials.' %}
                        Usuario o contraseña incorrectos.
                    {% else %}
                        {{ error.message }}
                    {% endif %}
                </div>
            {% endif %}
            <form method="post" action="{{ path('admin_login') }}">
                <label for="username">Usuario</label>
                <input id="username" name="username" autocomplete="username" value="{{ last_username }}" required autofocus>
                <label for="password">Contraseña</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_admin') }}">
                <button class="btn btn-block" type="submit" style="margin-top:1.1rem;">Entrar al panel</button>
            </form>
        </section>
    </main>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Justificación · E.P.E.T N1</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="icon" href="{{ asset('uploads/logo/logo-epet-n1.png') }}" type="image/png">
</head>
<body>
    <div class="mobile-shell">
        <header class="mobile-header">
            {% include 'partials/college_logo.html.twig' with { logo_variant: 'compact', logo_href: '#' } only %}
        </header>
        <main class="mobile">
            <h1>Justificación</h1>

            {% if estado == 'invalido' %}
                <div class="card">
                    <div class="alert alert-error" role="alert">Este código venció, ya se usó o no existe. Generá uno nuevo desde Ingreso.</div>
                    <div class="empty-state">
                        <div class="empty-state__icon" aria-hidden="true">⏱</div>
                        <strong>Enlace no disponible</strong>
                        <span>Pedí un QR nuevo en la pantalla de ingreso.</span>
                    </div>
                </div>
            {% elseif estado == 'enviado' %}
                <div class="card">
                    <div class="alert alert-success" role="status">La justificación se cargó correctamente.</div>
                    <div class="empty-state">
                        <div class="empty-state__icon" aria-hidden="true">✓</div>
                        <strong>Listo</strong>
                        <span>Podés cerrar esta página.</span>
                    </div>
                </div>
            {% else %}
                {% if error %}
                    <div class="alert alert-error" role="alert">{{ error }}</div>
                {% endif %}

                <section class="card">
                    {% if estado == 'password' %}
                        <p class="meta">Confirmá tu identidad para continuar.</p>
                        <h2 style="font-size:1.15rem;">{{ profesor.nombreCompleto }}</h2>
                        <form method="post">
                            <label for="password">Contraseña</label>
                            <input id="password" name="password" type="password" autocomplete="current-password" required>
                            <input type="hidden" name="_token" value="{{ csrf_token('justificar_password') }}">
                            <button class="btn btn-accent btn-block" type="submit" style="margin-top:1rem;">Continuar</button>
                        </form>
                    {% else %}
                        <form method="post" enctype="multipart/form-data" id="form-justificacion">
                            <label for="tipo">Tipo</label>
                            <select id="tipo" name="tipo" required>
                                {% for valor, etiqueta in tipos %}
                                    <option value="{{ valor }}">{{ etiqueta }}</option>
                                {% endfor %}
                            </select>

                            <label>Fechas</label>
                            <div id="fechas">
                                <input type="date" name="fechas[]" value="{{ hoy }}" required>
                            </div>
                            <button class="btn btn-ghost btn-sm" type="button" id="agregar-fecha" style="margin-top:0.6rem;">+ Agregar otra fecha</button>

                            <label for="motivo">Motivo</label>
                            <textarea id="motivo" name="motivo" required placeholder="Breve descripción del motivo"></textarea>

                            <label for="archivo">Archivo (JPG, PNG, PDF, DOC o DOCX, máx. 4 MB)</label>
                            <input id="archivo" name="archivo" type="file" accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,image/jpeg,image/png,application/pdf" required>

                            <input type="hidden" name="_token" value="{{ csrf_token('justificar_form') }}">
                            <button class="btn btn-accent btn-block" type="submit" style="margin-top:1rem;">Enviar justificación</button>
                        </form>
                        <script>
                            document.getElementById('agregar-fecha').addEventListener('click', function () {
                                var input = document.createElement('input');
                                input.type = 'date';
                                input.name = 'fechas[]';
                                input.style.marginTop = '0.5rem';
                                document.getElementById('fechas').appendChild(input);
                            });
                        </script>
                    {% endif %}
                </section>
            {% endif %}
        </main>
        <footer class="site-footer">
            {% include 'partials/college_logo.html.twig' with { logo_variant: 'compact', logo_href: '#' } only %}
            <span>Justificación móvil</span>
        </footer>
    </div>
</body>
</html>

{# Logo institucional E.P.E.T. N°1 #}
{% set colegio_nombre = colegio_nombre|default('E.P.E.T N1') %}
{% set colegio_tagline = colegio_tagline|default('Sistema de asistencia docente') %}
{% set logo_variant = logo_variant|default('full') %}
{% set logo_src = asset('uploads/logo/logo-epet-n1.png') %}
{% set show_name = logo_variant in ['full', 'compact'] %}
{% set show_tagline = logo_variant in ['full', 'hero'] %}

<a class="college-logo college-logo--{{ logo_variant }}" href="{{ logo_href|default('#') }}" {% if logo_href is not defined or logo_href == '#' %}aria-current="page"{% endif %}>
    <span class="college-logo__mark">
        <img
            class="college-logo__img"
            src="{{ logo_src }}"
            alt="{{ colegio_nombre }} · La Rioja"
            width="500"
            height="500"
            decoding="async"
        >
    </span>
    {% if show_name or show_tagline %}
        <span class="college-logo__text">
            {% if show_name %}
                <span class="college-logo__name">{{ colegio_nombre }}</span>
            {% endif %}
            {% if show_tagline %}
                <span class="college-logo__tagline">{{ colegio_tagline }}</span>
            {% endif %}
        </span>
    {% endif %}
</a>
